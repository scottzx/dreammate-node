{
  "name": "@1agents/dreammate-node",
  "version": "0.16.0",
  "description": "DreamMate Network 的设备网关与一次性 CLI：服务发现、调用与可导入的设备地址簿。",
  "keywords": [
    "dreammate",
    "node-agent",
    "service-registry",
    "tailscale",
    "discovery"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottzx/dreammate-node.git"
  },
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./client": {
      "types": "./dist/src/client.d.ts",
      "import": "./dist/src/client.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "dreammate-node": "dist/bin/dreammate-node.js"
  },
  "workspaces": [
    "packages/skill-manager",
    "packages/artifact-index"
  ],
  "files": [
    "dist/bin/*.js",
    "dist/bin/*.d.ts",
    "dist/src/*.js",
    "dist/src/*.d.ts",
    "scripts/install-skills.mjs",
    "scripts/local-embeddings/*.mjs",
    "scripts/local-embeddings/*.py",
    "scripts/local-embeddings/requirements.txt",
    "docs/local-embeddings.md",
    "docs/tool-search-evaluation.md",
    "docs/custom-mcp.md",
    "docs/device-info.md",
    "skills/ish/dreammate-node/SKILL.md",
    "skills/terminal/dreammate-node/SKILL.md",
    "README.md",
    "scripts/audit-dependencies.mjs",
    "ecosystem"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "npm run build:node",
    "build:node": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "build:all": "npm run build && npm run skill-manager:build",
    "skill-manager:build": "npm run build --workspace=@1agents/skill-manager",
    "skill-manager:check": "npm run check --workspace=@1agents/skill-manager",
    "artifact-index:check": "npm run check --workspace=@1agents/artifact-index",
    "typecheck": "tsc -p tsconfig.node-tests.json --noEmit",
    "typecheck:integration": "npm run skill-manager:build && tsc -p tsconfig.json --noEmit",
    "typecheck:all": "npm run typecheck && npm run typecheck --workspace=@1agents/skill-manager && npm run typecheck:integration",
    "test": "npm run test:node",
    "test:all": "npm test && npm run test --workspace=@1agents/skill-manager && npm run artifact-index:check && npm run test:integration",
    "test:node": "node --import tsx --test test/*.test.ts test/*.test.mjs deploy/plane-bridge/bridge.test.mjs",
    "test:integration": "npm run skill-manager:build && node --import tsx --test test/*.integration.ts",
    "test:packages": "npm run build:all && node scripts/check-package-boundary.mjs",
    "check:all": "npm run typecheck:all && npm run test:all && npm run test:packages",
    "postinstall": "node scripts/install-skills.mjs --postinstall",
    "skills:install": "node scripts/install-skills.mjs",
    "prepack": "npm run build",
    "audit:dependencies": "node scripts/audit-dependencies.mjs --root . --json",
    "test:governance": "node --test test/audit-dependencies.test.mjs"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "@1agents/dreammate-network": "^0.5.0",
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
