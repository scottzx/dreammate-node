{
  "name": "@1agents/dreammate-node",
  "version": "0.9.1",
  "description": "DreamMate Network 的设备网关与一次性 CLI：服务发现、调用与可导入的设备地址簿。",
  "keywords": [
    "dreammate",
    "node-agent",
    "service-registry",
    "tailscale",
    "discovery"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottzx/dreammate-node.git"
  },
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./client": {
      "types": "./dist/src/client.d.ts",
      "import": "./dist/src/client.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "dreammate-node": "dist/bin/dreammate-node.js"
  },
  "files": [
    "dist/bin/*.js",
    "dist/bin/*.d.ts",
    "dist/src/*.js",
    "dist/src/*.d.ts",
    "scripts/install-skills.mjs",
    "scripts/local-embeddings/*.mjs",
    "scripts/local-embeddings/*.py",
    "scripts/local-embeddings/requirements.txt",
    "docs/local-embeddings.md",
    "docs/tool-search-evaluation.md",
    "skills/ish/dreammate-node/SKILL.md",
    "skills/terminal/dreammate-node/SKILL.md",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts test/*.test.mjs deploy/plane-bridge/bridge.test.mjs",
    "postinstall": "node scripts/install-skills.mjs --postinstall",
    "skills:install": "node scripts/install-skills.mjs",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "@1agents/dreammate-network": "^0.5.0",
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
