{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2023"],
    "module": "NodeNext", "moduleResolution": "NodeNext",
    "rootDir": ".", "outDir": "dist",
    "strict": true, "declaration": true, "skipLibCheck": true,
    "esModuleInterop": true, "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true, "noUnusedParameters": true, "noImplicitOverride": true
  },
  "include": ["src/**/*.ts", "bin/**/*.ts", "test/**/*.ts"]
}
